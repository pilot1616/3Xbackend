SERVER_PORT=3000

MYSQL_ROOT_PASSWORD=change-this-mysql-root-password
MYSQL_DATABASE=3X

DATABASE_MYSQL_USER=root
DATABASE_MYSQL_PASSWORD=change-this-mysql-root-password
DATABASE_MYSQL_SCHEMA=3X

AUTH_SECRET=change-this-to-a-long-random-secret
AUTH_ADMIN_USERNAMES=admin

APP_IMAGE=3xbackend-app:latest
AGENT_IMAGE=3xbackend-agent:latest
DATA_FETCH_IMAGE=3xbackend-data-fetch:latest

LLM_BASE_URL=https://ai-api-gateway.app.baizhi.cloud/api/openai
LLM_API_KEY=replace-me
LLM_MODEL=dev/gpt-5.5
LLM_TIMEOUT_SECONDS=60
AGENT_ALLOWED_TABLES=
AGENT_SAMPLE_ROW_LIMIT=5

DATA_FETCH_INTERVAL_SECONDS=3600
DATA_FETCH_HISTORY_START_YEAR=2018
DATA_FETCH_RUN_LOOP=true

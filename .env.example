SERVER_PORT=3000
AUTH_ADMIN_USERNAMES=
# 生产环境必须设置强随机密钥（如 `openssl rand -hex 32`）
AUTH_SECRET=
# 仅本地开发允许使用默认密钥时设为 1
AUTH_ALLOW_DEFAULT_SECRET=
# 浏览器跨域白名单（逗号分隔），如 https://example.com；留空表示允许任意来源（仅限本地开发）
CORS_ALLOWED_ORIGINS=

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=3X

DATABASE_MYSQL_USER=root
DATABASE_MYSQL_PASSWORD=root
DATABASE_MYSQL_ADDRESS=127.0.0.1
DATABASE_MYSQL_PORT=3306
DATABASE_MYSQL_SCHEMA=3X

VITE_API_BASE_URL=http://localhost:3000
VITE_ASSET_BASE_URL=http://localhost:3000

AGENT_PORT=8010
# 内部服务令牌：设置后 agent 服务要求请求携带 X-Agent-Token，Go 后端代理会自动携带
# 生产环境必须设置，且与 Go 后端（AGENT_INTERNAL_TOKEN）保持一致
AGENT_INTERNAL_TOKEN=
LLM_BASE_URL=https://ai-api-gateway.app.baizhi.cloud/api/openai
LLM_API_KEY=replace-me
LLM_MODEL=dev/gpt-5.5
LLM_TIMEOUT_SECONDS=35
AGENT_ALLOWED_TABLES=
AGENT_SAMPLE_ROW_LIMIT=5

DATA_FETCH_INTERVAL_SECONDS=3600
DATA_FETCH_HISTORY_START_YEAR=2018
DATA_FETCH_BASE_URL=http://localhost:8020
DATA_FETCH_PORT=8020
DATA_FETCH_RUN_LOOP=true
SYNC_AI_DAILY_MAX_ENTRIES=10000
SEED_USERS=80
SEED_QUESTIONS=120
SEED_MIN_COMMENTS=1
SEED_MAX_COMMENTS=8
SEED_MIN_LIKES=0
SEED_MAX_LIKES=20
SEED_MAX_ASSETS=4

AGENT_HOST=0.0.0.0
AGENT_PORT=8010

DATABASE_MYSQL_USER=root
DATABASE_MYSQL_PASSWORD=root
DATABASE_MYSQL_ADDRESS=127.0.0.1
DATABASE_MYSQL_PORT=3306
DATABASE_MYSQL_SCHEMA=3X

LLM_BASE_URL=https://ai-api-gateway.app.baizhi.cloud/api/openai
LLM_API_KEY=replace-me
LLM_MODEL=dev/gpt-5.5
LLM_TIMEOUT_SECONDS=60

AGENT_ALLOWED_TABLES=
AGENT_SAMPLE_ROW_LIMIT=5
# 设置后所有业务接口要求 X-Agent-Token 头匹配此令牌；留空则不校验（仅限本地开发）
AGENT_INTERNAL_TOKEN=
# 浏览器跨域白名单（逗号分隔）；留空表示允许任意来源（仅限本地开发）
CORS_ALLOWED_ORIGINS=
